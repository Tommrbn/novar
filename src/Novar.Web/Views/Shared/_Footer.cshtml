@{ var homeFooter = ViewData["HomeFooter"] is true; }
<footer class="site-footer">
    <div class="container-novar">
        <div class="footer-grid">
            <div class="footer-brand"><a href="/" aria-label="@T["Novar, inicio"]">
                @if (homeFooter)
                {
                    <img class="home-footer-logo" src="~/media/novar-footer.svg" alt="Novar" width="240" height="32" />
                }
                else
                {
                    <img class="site-footer-logo" src="~/media/figma/e7f22.svg" alt="Novar" />
                }
            </a><p>@T["Tecnología óptica de precisión para una visión más natural, clara y confortable."]</p><partial name="_SocialLinks" /></div>
            <div><h2>@T["Productos"]</h2><ul><li><a href="/lentes">@T["Progresivos"]</a></li><li><a href="/lentes">@T["Ocupacionales"]</a></li><li><a href="/lentes">@T["Monofocales"]</a></li><li><a href="/lentes">@T["Bifocales"]</a></li><li><a href="/lentes">@T["Premium"]</a></li></ul></div>
            <div><h2 class="visually-hidden">Novar</h2><ul><li><a href="/sobre-nosotros">@T["Sobre nosotros"]</a></li><li><a href="/tratamientos">@T["Tratamientos"]</a></li><li><button type="button" data-pending="@T["Garantía"]">@T["Garantía"]</button></li><li><a href="/juegos">@T["Juegos visuales"]</a></li><li><a href="/#contacto">@T["Contacto"]</a></li></ul></div>
            <div><h2>@T["Contacto"]</h2><p>mkt@novar-tech.com</p><p>@T["Presencia internacional"]</p>
                @if (!homeFooter)
                {
                    <a class="sample-link" href="/lentes/first">@T["Ver muestra: Novar First →"]</a>
                }
            </div>
        </div>
        <p class="copyright">@T["© 2026 Novar. Todos los derechos reservados."]</p>
        <p class="sample-note">@T["Muestra de diseño · Home + Novar First. El resto del sitio espera aprobación visual."]</p>
    </div>
</footer>
