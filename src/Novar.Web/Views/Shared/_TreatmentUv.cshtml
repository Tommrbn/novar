@model TreatmentDetail
<section id="@Model.Id" class="treatment-detail treatment-detail-uv" aria-labelledby="treatment-uv-title" data-treatment-detail="uv">
    <div class="treatment-uv-summary" data-figma-node="@Model.SourceNode">
        <div><p class="treatment-uv-eyebrow">TRATAMIENTO</p><h2 id="treatment-uv-title">@Model.Name</h2></div>
        <p class="treatment-uv-description">@Model.Description</p>
    </div>
    <div class="treatment-uv-photo" data-figma-node="961:9643">
        <div class="treatment-uv-image-plane">
            <img class="treatment-uv-image" src="~/media/figma/@Model.Image" alt="Mujer con lentes transparentes al aire libre" width="2752" height="1536" />
            <img class="treatment-uv-source-arrows" src="~/media/figma/b9b6a.svg" alt="" aria-hidden="true" />
        </div>
    </div>
    <ul class="treatment-uv-benefits" aria-label="Características de Protección UV" data-figma-node="961:9775">
        @foreach (var benefit in Model.Benefits)
        {
            <li><span class="treatment-benefit-check"><img src="~/media/figma/7bc95.svg" alt="" /></span><span>@benefit</span></li>
        }
    </ul>
</section>
