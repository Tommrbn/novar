@model TriviaContent
<section class="games-arena games-trivia" id="trivia-panel" hidden aria-labelledby="trivia-title" aria-describedby="trivia-disclaimer" data-trivia-revision="trivia-v1">
    <header class="games-arena-heading"><span aria-hidden="true">03</span><h2 id="trivia-title">@Model.Title</h2></header>
    <p id="trivia-disclaimer" class="trivia-disclaimer">@Model.Disclaimer</p>
    <div id="trivia-play">
        <p id="trivia-progress" class="trivia-progress">Pregunta 1 de @Model.Questions.Length</p>
        @for (var questionIndex = 0; questionIndex < Model.Questions.Length; questionIndex++)
        {
            var question = Model.Questions[questionIndex];
            <fieldset class="trivia-question" data-trivia-question data-correct-index="@question.CorrectIndex" hidden>
                <legend tabindex="-1">@question.Question</legend>
                <div class="trivia-options">
                    @for (var optionIndex = 0; optionIndex < question.Options.Length; optionIndex++)
                    {
                        var optionId = $"trivia-{questionIndex}-{optionIndex}";
                        <label class="trivia-option" for="@optionId">
                            <input id="@optionId" type="radio" name="trivia-question-@questionIndex" value="@optionIndex" />
                            <span class="trivia-option-letter" aria-hidden="true">@((char)('A' + optionIndex)).</span>
                            <span class="trivia-option-text">@question.Options[optionIndex]</span>
                        </label>
                    }
                </div>
            </fieldset>
        }
        <p id="trivia-feedback" class="trivia-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="trivia-actions">
            <button id="trivia-check" type="button" class="btn btn-novar" disabled>Comprobar</button>
            <button id="trivia-next" type="button" class="btn btn-novar" hidden>Siguiente</button>
        </div>
    </div>
    <div id="trivia-result" class="trivia-result" hidden>
        <h3 id="trivia-score" tabindex="-1"></h3>
        <p>Podés volver a responder las diez preguntas.</p>
        <button id="trivia-retry" type="button" class="btn btn-novar">Reintentar</button>
    </div>
</section>
