@model TreatmentDetail
<section id="@Model.Id" class="treatment-detail treatment-detail-hidrofobico" aria-labelledby="treatment-hidrofobico-title" data-treatment-detail="hidrofobico" data-figma-node="961:8795">
    <div class="treatment-hidrofobico-summary" data-figma-node="@Model.SourceNode">
        <div><p class="treatment-hidrofobico-eyebrow">@T["TRATAMIENTO"]</p><h2 id="treatment-hidrofobico-title">@Model.Name</h2></div>
        <p class="treatment-hidrofobico-description">@Model.Description</p>
    </div>
    <div class="treatment-hidrofobico-photo" data-treatment-media data-figma-node="961:8797">
        <div class="treatment-hidrofobico-image-plane" data-figma-node="I961:8797;1:2038">
            <video data-treatment-video loop class="treatment-hidrofobico-image" aria-label="@Model.Name" muted playsinline preload="none" hidden data-treatment-desktop="/media/treatments/optimized/hidrofobico-desktop.mp4" data-treatment-mobile="/media/treatments/optimized/hidrofobico-mobile.mp4">
            </video>
            <img class="treatment-hidrofobico-image" data-treatment-fallback src="~/media/treatments/optimized/hidrofobico-poster-1280.webp" srcset="/media/treatments/optimized/hidrofobico-poster-640.webp 640w, /media/treatments/optimized/hidrofobico-poster-1280.webp 1280w, /media/treatments/optimized/hidrofobico-poster-1920.webp 1920w" sizes="(max-width: 767.98px) 125vw, 117vw" loading="lazy" decoding="async" alt="@Model.Name" />
        </div>
    </div>
    <ul class="treatment-hidrofobico-benefits" aria-label="@T["Características de Hidrofóbico"]" data-figma-node="961:8929">
        @foreach (var benefit in Model.Benefits)
        {
            <li><span class="treatment-benefit-check"><img src="~/media/figma/7bc95.svg" alt="" /></span><span>@benefit</span></li>
        }
    </ul>
</section>
