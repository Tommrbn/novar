<footer class="prg-footer">
    <div class="prg-footer-inner">
        <div class="prg-footer-grid">
            <div class="prg-footer-brand">
                <a class="prg-footer-logo" href="/" aria-label="@T["Novar, inicio"]">
                    <img class="prg-logo-n" src="~/media/figma/4fa2a.svg" alt="" />
                    <img class="prg-logo-v" src="~/media/figma/f87fc.svg" alt="" />
                    <img class="prg-logo-a" src="~/media/figma/97fd8.svg" alt="" />
                    <img class="prg-logo-o" src="~/media/figma/dabcc.svg" alt="" />
                    <img class="prg-logo-r" src="~/media/figma/e27ca.svg" alt="" />
                </a>
                <p>@T["Tecnología óptica de precisión para una visión más natural, clara y confortable."]</p>
            </div>
            <div>
                <h2>@T["Productos"]</h2>
                <ul class="prg-footer-products">
                    <li><a href="/lentes">@T["Progresivos"]</a></li>
                    <li><a href="/lentes">@T["Ocupacionales"]</a></li>
                    <li><a href="/lentes">@T["Monofocales"]</a></li>
                    <li><a href="/lentes">@T["Bifocales"]</a></li>
                    <li><a href="/lentes">@T["Premium"]</a></li>
                </ul>
            </div>
            <div>
                <h2 class="visually-hidden">Novar</h2>
                <ul>
                    <li><a href="/sobre-nosotros">@T["Sobre nosotros"]</a></li>
                    <li><a href="/tratamientos">@T["Tratamientos"]</a></li>
                    <li><button type="button" data-pending="@T["Garantía"]">@T["Garantía"]</button></li>
                    <li><a href="/juegos">@T["Juegos visuales"]</a></li>
                </ul>
            </div>
            <div>
                <h2>@T["Contacto"]</h2>
                <ul><li>mkt@novar-tech.com</li><li>@T["Presencia internacional"]</li></ul>
            </div>
        </div>
        <div class="prg-footer-socials" aria-label="@T["Redes sociales pendientes de integración"]">
            <button type="button" data-pending="Instagram" aria-label="@T["Instagram: pendiente de integración"]"><img src="~/media/figma/c8445.svg" alt="" /></button>
            <button type="button" data-pending="LinkedIn" aria-label="@T["LinkedIn: pendiente de integración"]"><img src="~/media/figma/@(ViewData["ProgressiveVariant"] as string == "first" ? "1db5c.svg" : ViewData["ProgressiveVariant"] as string == "evolution-short" ? "68b8d.svg" : "9f628.svg")" alt="" /></button>
            <button type="button" data-pending="Facebook" aria-label="@T["Facebook: pendiente de integración"]"><img src="~/media/figma/9daba.svg" alt="" /></button>
            <button type="button" data-pending="YouTube" aria-label="@T["YouTube: pendiente de integración"]"><img src="~/media/figma/e3672.svg" alt="" /></button>
        </div>
        <p class="prg-copyright">@T["© 2026 Novar. Todos los derechos reservados."]</p>
    </div>
</footer>
