@model TreatmentDetail
<section id="@Model.Id" class="treatment-detail treatment-detail-antirraya" aria-labelledby="treatment-antirraya-title" data-treatment-detail="antirraya" data-figma-node="961:9368">
    <div class="treatment-antirraya-summary" data-figma-node="@Model.SourceNode">
        <div><p class="treatment-antirraya-eyebrow">@T["TRATAMIENTO"]</p><h2 id="treatment-antirraya-title">@Model.Name</h2></div>
        <p class="treatment-antirraya-description">@Model.Description</p>
    </div>
    <div class="treatment-antirraya-photo" data-treatment-media data-figma-node="961:9917">
        <div class="treatment-antirraya-video-plane" data-media-source="user-supplied">
            <video class="treatment-antirraya-video" data-treatment-video loop muted playsinline preload="none" aria-label="@Model.Name" hidden data-treatment-desktop="/media/treatments/optimized/antirraya-desktop.mp4" data-treatment-mobile="/media/treatments/optimized/antirraya-mobile.mp4">
            </video>
            <img class="treatment-antirraya-fallback" data-treatment-fallback src="~/media/treatments/optimized/antirraya-poster-1280.webp" srcset="/media/treatments/optimized/antirraya-poster-640.webp 640w, /media/treatments/optimized/antirraya-poster-1280.webp 1280w, /media/treatments/optimized/antirraya-poster-1920.webp 1920w" sizes="(max-width: 767.98px) 125vw, 117vw" loading="lazy" decoding="async" alt="@T["Mujer con gafas transparentes: la lente de la izquierda presenta rayas y la de la derecha se ve clara"]" width="2752" height="1536" />
        </div>
    </div>
    <ul class="treatment-antirraya-benefits" aria-label="@T["Características de Antirraya"]" data-figma-node="961:9502">
        @foreach (var benefit in Model.Benefits)
        {
            <li><span class="treatment-benefit-check"><img src="~/media/figma/7bc95.svg" alt="" /></span><span>@benefit</span></li>
        }
    </ul>
</section>
