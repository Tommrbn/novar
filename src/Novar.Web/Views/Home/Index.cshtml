<section class="testimonials container-novar" aria-labelledby="testimonials-title" data-testimonial-carousel data-home-refinements-revision="home-refinements-v1"><h2 id="testimonials-title">@T["Tu experiencia"]</h2>
    <div class="testimonial-grid" id="testimonial-list"><blockquote class="testimonial-side"><p>Marcos G.</p><footer>@T["Progresivo"] · Evolution</footer></blockquote>
        <blockquote class="testimonial-main"><div class="quote-stars" aria-hidden="true"><img src="~/media/figma/1e0d2.svg" width="14" height="14" alt="" /><img src="~/media/figma/1e0d2.svg" width="14" height="14" alt="" /><img src="~/media/figma/1e0d2.svg" width="14" height="14" alt="" /></div><p>Hernán Darío</p><footer>@T["Monofocal"] · Novar</footer><q>@T["Son los mejores, por eso no los cambio por nada."]</q></blockquote>
        <blockquote class="testimonial-side"><p>Valentina R.</p><footer>@T["Progresivo"] · eLIFE</footer></blockquote>
    </div>
    <div class="testimonial-controls" hidden>
        <button type="button" class="round-button" data-testimonial-previous aria-controls="testimonial-list" aria-label="@T["Experiencia anterior"]"><img src="~/media/figma/e30c0.svg" alt="" width="18" height="18" /></button>
        <button type="button" class="testimonial-motion-toggle" aria-controls="testimonial-list" aria-pressed="false">@T["Pausar experiencias"]</button>
        <button type="button" class="round-button" data-testimonial-next aria-controls="testimonial-list" aria-label="@T["Experiencia siguiente"]"><img src="~/media/figma/afd96.svg" alt="" width="18" height="18" /></button>
    </div>
