@model HomeContent
@{
    ViewData["Title"] = T["La visión define tu historia"];
    ViewData["HomeFooter"] = true;
}
<section class="home-hero" aria-labelledby="home-title" data-figma-node="889:1324" data-home-revision="home-fidelity-v2" data-home-annotations-revision="home-annotations-v1" data-home-media-player="hero" data-home-media-source="/media/home/optimized/hero-banner.mp4" data-home-media-revision="home-media-v2">
    <img class="hero-background" src="~/media/home/optimized/hero-banner.webp" alt="" width="1440" height="999" fetchpriority="high" />
    <video class="hero-background home-hero-video" data-home-media-video id="home-hero-video" width="1440" height="840" muted loop playsinline preload="none" poster="@Url.Content("~/media/home/optimized/hero-banner.webp")" aria-hidden="true" tabindex="-1" hidden></video>
    <div class="hero-copy"><h1 id="home-title">@T["La visión"]<br />@T["define tu historia"]</h1></div>
    <p class="hero-caption">@T["AI-DRIVEN VISION"]</p>
    <button class="home-video-toggle hero-video-toggle" type="button" data-home-media-toggle aria-controls="home-hero-video" aria-label="@T["Reproducir video de portada"]" hidden>@T["Reproducir video de portada"]</button>
    <a class="hero-next" href="#encontra" aria-label="@T["Descubrir los lentes"]"><img src="~/media/figma/9e5ee.svg" alt="" width="52.6" height="44.6" /></a>
</section>

<section class="finder container-novar" id="encontra" aria-labelledby="finder-title">
    <div class="finder-art" data-home-media-player="finder" data-home-media-source="/media/home/lens-finder.mp4">
        <img src="~/media/figma/lens-finder-poster.png" alt="@T["Anteojos con lentes de color ámbar"]" width="604" height="455" loading="lazy" />
        <video class="home-finder-video" data-home-media-video id="home-finder-video" width="2560" height="1440" muted loop playsinline preload="none" poster="@Url.Content("~/media/figma/lens-finder-poster.png")" aria-hidden="true" tabindex="-1" hidden></video>
        <button class="home-video-toggle finder-video-toggle" type="button" data-home-media-toggle aria-controls="home-finder-video" aria-label="@T["Reproducir video de los lentes"]" hidden>@T["Reproducir video de los lentes"]</button>
    </div>
    <div class="finder-content"><h2 id="finder-title">@T["Encontrá"]<br /><strong>@T["tu lente ideal"]</strong></h2>
        <p>@T["Utilizá los filtros para elegir según tu"] <strong>@T["edad"]</strong>, @T["tus"] <strong>@T["necesidades visuales"]</strong> @T["o tus"] <strong>@T["actividades diarias"]</strong>.</p>
        <div class="finder-choices">
            <button type="button" data-pending="@T["feature:Recomendador por edad"]">@T["Por edad"] <span aria-hidden="true">+</span></button>
            <button type="button" data-pending="@T["feature:Recomendador por necesidad"]">@T["Por necesidad"] <span aria-hidden="true">+</span></button>
            <button type="button" data-pending="@T["feature:Recomendador por actividades y preferencias"]">@T["Por actividades y preferencias"] <span aria-hidden="true">+</span></button>
        </div>
        <a class="btn btn-novar" href="/lentes">@T["Explorá todos los lentes"] <span aria-hidden="true">→</span></a>
    </div>
</section>

<section class="featured container-novar" aria-labelledby="featured-title">
    <p class="eyebrow">@T["Destacados"]</p><h2 id="featured-title">@T["Diseñados para mejorar"]<br />@T["la forma de ver el mundo"]</h2>
    <p>@T["Los lentes más avanzados de Novar. Tecnología y experiencia visual sin compromisos."]</p>
    <div class="featured-grid">
        @foreach (var item in Model.Highlights)
        {
            <article class="lens-card">
                <span class="tag">@T["Destacado"]</span><img class="lens-card-image @(item.Slug == "ai-lens" ? "lens-card-image-mirrored" : "")" src="/media/figma/@item.Image" width="192" height="172" alt="@T["Persona usando lentes"] @item.Name" loading="lazy" />
                <h3>@item.Name</h3><p class="lens-description">@item.Description</p>
                <dl class="clarity-bars">
                    @foreach (var benefit in item.Benefits)
                    {
                        <div><dt>@benefit.Label</dt><dd>@benefit.Level</dd><div class="clarity-track" aria-hidden="true"><span style="width: @(benefit.Percent)%"></span></div></div>
                    }
                </dl>
                @if (item.Slug.Length > 0)
                {
                <a class="card-cta" href="/lentes/@item.Slug">@T["Descubrí más"] <span aria-hidden="true">→</span></a>
                }
                else
                {
                    <a class="card-cta myofix-card-link" href="https://www.novarmyofix.com/" aria-label="@T["Descubrí más sobre MyoFix"]">@T["Descubrí más"] <span aria-hidden="true">→</span></a>
                }
            </article>
        }
    </div>
</section>

<section class="sophia-section container-novar" aria-labelledby="sophia-title" data-home-motion-revision="home-motion-v1">
    <div class="sophia-copy"><p class="sophia-label"><img src="~/media/figma/84d44.svg" alt="" width="30" height="30" /> @T["Tenés dudas? Preguntale a Sophia"]</p>
        <h2 id="sophia-title">@T["Elegir un lente no debería"]<br />@T["ser una adivinanza"]</h2>
        <p>@T["Preguntale a Sophia. La inteligencia artificial"]<br class="desktop-only" /> @T["que te guía hacia la mejor opción."]</p>
        <div class="sophia-actions"><button class="btn btn-novar" type="button" data-pending="Sophia"><img src="~/media/figma/b7758.svg" alt="" width="28" height="21" /> @T["24/7/365 Assistance"]</button><button class="btn btn-outline-novar" type="button" data-pending="@T["Sophia multilenguaje"]"><img src="~/media/figma/f915d.svg" alt="" width="21" height="21" /> @T["Multilenguaje"]</button></div>
    </div>
    <div class="sophia-questions" role="region" aria-label="@T["Preguntas que podés hacerle a Sophia"]" data-sophia-carousel>
        <div class="sophia-question-stage">
            <span class="sophia-selection-marker" aria-hidden="true"><img src="~/media/figma/539c7.svg" alt="" width="34.1358" height="29.5625" /></span>
            <ul class="sophia-question-list" id="sophia-question-list">
                <li data-figma-node="889:1443">@T["¿Qué hacer si tengo molestias?"]</li>
                <li data-figma-node="889:1444">@T["¿Qué test visuales puedo realizar como orientación?"]</li>
                <li data-figma-node="889:1445">@T["¿Cómo leer mi receta?"]</li>
                <li class="selected" data-figma-node="889:1446">@T["¿Qué lentes necesito?"]</li>
                <li data-figma-node="889:1447">@T["¿Cómo controlar la miopía?"]</li>
                <li data-figma-node="889:1448">@T["¿Cómo adaptarme a mis lentes?"]</li>
                <li data-figma-node="889:1449">@T["¿Cómo conocer el estado de un pedido?"]</li>
            </ul>
        </div>
        <button class="sophia-motion-toggle" type="button" aria-controls="sophia-question-list" hidden>@T["Pausar preguntas"]</button>
    </div>
</section>

<section class="home-treatments" aria-labelledby="treatments-title"><div class="container-novar treatment-grid">
    <div class="treatment-copy"><p class="eyebrow" data-figma-node="889:2156"><span>@T["¿Sabías que...?"]</span></p><h2 id="treatments-title">@T["Podés mejorar tu bienestar visual"] <span>@T["con un pequeño cambio"]</span></h2>
        <p>@T["Los filtros en los lentes están pensados para"] <strong>@T["mejorar tu visión"]</strong> @T["en diferentes situaciones. Protege tus ojos y te ayuda a ver mejor, dependiendo de la actividad que estes realizando."]</p>
        <ul class="comfort-benefits">
            <li><span class="comfort-icon comfort-icon-eye" aria-hidden="true"><img src="~/media/figma/bf6dd.svg" alt="" width="68.2077" height="68.2077" /><img src="~/media/figma/6c179.svg" alt="" width="35.5037" height="30.5816" /></span><span>@T["Menos fatiga"]<br />@T["visual"]</span></li>
            <li><span class="comfort-divider" aria-hidden="true"><img src="~/media/figma/6acd9.svg" alt="" width="68.2077" height="0.921725" /></span><span class="comfort-icon" aria-hidden="true"><img src="~/media/figma/38049.svg" alt="" width="68.2077" height="68.2077" /></span><span>@T["Mayor"]<br />@T["comodidad"]</span></li>
            <li><span class="comfort-divider" aria-hidden="true"><img src="~/media/figma/6acd9.svg" alt="" width="68.2077" height="0.921725" /></span><span class="comfort-icon" aria-hidden="true"><img src="~/media/figma/37216.svg" alt="" width="68.2077" height="68.2077" /></span><span>@T["Protección"]<br />@T["según tu rutina"]</span></li>
        </ul>
        <a class="btn btn-novar treatment-cta" href="/tratamientos" data-figma-node="889:1764">@T["Conocé más"]<img src="~/media/figma/e3b22.svg" alt="" width="15" height="15" /></a>
    </div>
    <div class="treatment-collage" id="home-treatment-collage" data-treatment-collage data-pause-label="@T["Pausar imágenes"]" data-resume-label="@T["Reanudar imágenes"]"><img class="collage-main" src="~/media/figma/2cc9c.png" alt="@T["Mujer con lentes de color ámbar"]" width="367" height="586" loading="lazy" /><img class="collage-child" src="~/media/figma/65071.png" alt="@T["Niña con anteojos al aire libre"]" width="249" height="208" loading="lazy" /><img class="collage-sport" src="~/media/figma/b3aff.png" alt="@T["Ciclista con lentes de protección"]" width="249" height="260" loading="lazy" />
        <span class="collage-tag tag-comfort"><span class="collage-eye" aria-hidden="true"><img src="~/media/figma/73742.svg" alt="" width="24" height="24" /><img src="~/media/figma/e52ae.svg" alt="" width="15" height="10" /></span>@T["Confort Visual"]</span>
        <span class="collage-tag tag-drive"><img src="~/media/figma/8dc9d.svg" alt="" width="24" height="24" />@T["Conducción"]</span>
        <span class="collage-tag tag-screen"><img src="~/media/figma/d2700.svg" alt="" width="24" height="24" />@T["Protección para pantallas"]</span>
        <span class="collage-tag tag-outdoor"><img src="~/media/figma/e8b67.svg" alt="" width="24" height="24" />@T["Para Exterior"]</span>
        <button class="collage-motion-toggle" type="button" aria-controls="home-treatment-collage" hidden>@T["Pausar imágenes"]</button>
    </div>
</div></section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true" defer></script>
    <script src="~/js/testimonials.js" asp-append-version="true" defer></script>
    <script src="~/js/home-media.js" asp-append-version="true" defer></script>
    <script src="~/js/home-world-mobile.js" asp-append-version="true" defer></script>
    <script src="~/js/home-treatment-collage.js" asp-append-version="true" defer></script>
}

