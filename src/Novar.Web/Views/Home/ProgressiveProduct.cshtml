@model ProgressiveProduct
@{
    ViewData["Title"] = $"Novar {Model.Name}";
    ViewData["ProgressivePage"] = true;
    ViewData["ProgressiveVariant"] = Model.Slug;
    var banner = ProductBannerAsset.ForSlug(Model.Slug);
}
<article class="progressive-product progressive-product--@Model.Slug" data-figma-node="@Model.SourceNode" data-progresivos-revision="progresivos-v1">
    <section class="prg-hero" aria-labelledby="prg-title">
        <div class="prg-hero-art" data-figma-node="@banner.SourceNode">
            <img src="~/media/products/banners/@banner.File" alt="@T["Persona con anteojos Novar"] @Model.Name" width="@banner.Width" height="@banner.Height" data-product-banner fetchpriority="high" />
        </div>
        <p class="prg-category">@T["PROGRESIVOS"]</p>
        <div class="prg-hero-copy">
            <h1 id="prg-title"><span class="visually-hidden">Novar @Model.Name</span><img class="prg-wordmark" src="~/media/figma/@Model.Wordmark" alt="" data-figma-node="@Model.WordmarkNode" /></h1>
            <h2>@Model.Subtitle</h2>
            <p>@Model.Description</p>
            <a class="btn btn-novar prg-button" href="/tratamientos">@T["Personalizá tu lente"]</a>
        </div>
    </section>
    <div class="prg-tagline" data-product-tagline>
        <div class="prg-tagline-art" aria-hidden="true"><img src="~/media/figma/33850.png" alt="" /></div>
        <img class="prg-tagline-orb" src="~/media/figma/5cebf.svg" alt="" />
        <p>@Model.Tagline</p>
    </div>
    <section class="prg-intro" aria-labelledby="prg-intro-title">
        <div class="prg-intro-panel">
            <div class="prg-scene"><img src="~/media/figma/@Model.Scene" alt="@T["Escena cotidiana con Novar"] @Model.Name" loading="lazy" /></div>
            <div class="prg-intro-copy">
                <p class="prg-intro-eyebrow">@Model.IntroEyebrow</p>
                <h2 id="prg-intro-title">@Model.IntroHeading</h2>
                <p class="prg-intro-description"><partial name="_ProgressiveText" model="new ProgressiveText(Model.Intro, Model.IntroEmphasis)" /></p>
                <ul class="prg-icons">
                    @foreach (var icon in Model.Icons)
                    {
                        <li><span><img src="~/media/figma/@icon.File" alt="" loading="lazy" /></span>@icon.Label</li>
                    }
                </ul>
            </div>
        </div>
    </section>
    <section class="prg-gallery" aria-labelledby="prg-gallery-title" aria-roledescription="@T["carrusel"]" data-progressive-gallery data-gallery-revision="progresivos-gallery-v2" data-gallery-sharp-outer="@(Model.Slug == "precisa" ? "true" : "false")">
        <h2 id="prg-gallery-title">@Model.GalleryName<img src="~/media/figma/@(Model.Slug == "evolution-short" ? "26db8.svg" : "cfae7.svg")" alt="®" /> <strong>@T["es para vos"]</strong></h2>
        <div class="prg-gallery-images" id="prg-@Model.Slug-gallery-images">
            @for (var i = 0; i < Model.Gallery.Length; i++)
            {
                <div data-gallery-image="@Model.Gallery[i]"><img src="~/media/figma/@Model.Gallery[i]" alt="@T["Persona con anteojos"] @Model.Name" loading="lazy" /></div>
            }
        </div>
        <partial name="_GalleryMotionControl" />
    </section>
    <section class="prg-treatments" aria-labelledby="prg-treatments-title">
        <h2 id="prg-treatments-title">@T["Mejorá tu visión con tratamientos"]</h2>
        <p>@T["Los tratamientos son tecnologías avanzadas que se aplican a las superficies de las lentes para mejorar su funcionalidad, durabilidad y comodidad visual"]</p>
        <a class="btn btn-novar prg-button" href="/tratamientos">@T["Conocelos"] <img src="~/media/figma/baa56.svg" alt="" /></a>
    </section>
    <section class="prg-details" aria-labelledby="prg-details-title">
        <div class="prg-details-copy">
            <p class="prg-eyebrow">@T["DETALLES DEL PRODUCTO"]</p>
            <h2 id="prg-details-title">@Model.DetailHeading</h2>
            <p><partial name="_ProgressiveText" model="new ProgressiveText(Model.Details, Model.DetailEmphasis)" /></p>
            <dl class="prg-specs">
                <div><dt>@T["Diseño:"]</dt><dd>@Model.Design</dd></div>
                <div><dt>@T["Ideal para:"]</dt><dd>@Model.IdealFor</dd></div>
                <div><dt>@T["Tecnología:"]</dt><dd>@Model.TechnologySpec</dd></div>
            </dl>
            <ul class="prg-tags">@foreach (var tag in Model.Tags) { <li>@tag</li> }</ul>
        </div>
        <figure><div class="prg-detail-photo"><img src="~/media/figma/@Model.Detail" alt="@T["Escena de uso de Novar"] @Model.Name" loading="lazy" /></div><figcaption>@T["SUPERFICIE DIGITAL PERSONALIZADA"]</figcaption></figure>
    </section>
    <section class="prg-technologies" aria-label="@T["Tecnologías de Novar"] @Model.Name">
        <span class="prg-watermark" aria-hidden="true">@(Model.Name == "eLIFE" ? Model.Name : Model.Name.ToLowerInvariant().Replace(" ", "\n"))</span>
        <div class="prg-technology-scroll" tabindex="0" role="region" aria-label="@T["Tecnologías; desplazá para ver las tarjetas"]">
            @foreach (var technology in Model.Technologies)
            {
                <div class="prg-technology-card"><h2>@technology.Name</h2><p>@technology.Description</p></div>
            }
        </div>
    </section>
    <section class="prg-benefits" aria-labelledby="prg-benefits-title">
        <div class="prg-container">
            <p class="prg-eyebrow">@T["BENEFICIOS"]</p><h2 id="prg-benefits-title">@T["Claridad donde la necesitás"]</h2>
            <p>@T["Una lectura simple del rendimiento visual esperado en cada distancia."]</p>
            <dl>@foreach (var benefit in Model.Benefits) { <div><dt>@benefit.Label</dt><dd><span aria-hidden="true">◉</span> @benefit.Level</dd></div> }</dl>
        </div>
    </section>
    <section class="prg-faq" aria-labelledby="prg-faq-title">
        <div><p class="prg-eyebrow">FAQ</p><h2 id="prg-faq-title">@T["Preguntas"]<br /> @T["frecuentes"]</h2><p>@T["Todo lo que necesitás saber antes de elegir tu próxima lente."]</p><a href="/#contacto">@T["¿Tenés otra duda? Contactanos →"]</a></div>
        <partial name="_Faq" model='new FaqSection($"prg-{Model.Slug}-faq", Model.Questions, 2)' />
    </section>
    <section class="prg-contact">
        <div><h2>@T["Tu próxima forma de ver empieza acá."]</h2><p>@T["Consultá con una óptica especializada y encontrá la configuración ideal para vos."]</p></div>
        <a class="btn btn-novar prg-button" href="/#contacto">@T["CONTACTANOS →"]</a>
    </section>
    <partial name="_ProgressiveRelated" />
</article>
@section Scripts {
    <script src="~/js/progressive-gallery.js" asp-append-version="true"></script>
}
